<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- On Android 12+, match the system splash to the loader's dark stage and
         show the folded-page mark before the in-app ink animation begins. -->
    <style name="Theme.NotesTakingApp.Splash" parent="Theme.NotesTakingApp">
        <item name="android:windowBackground">@color/loader_bg</item>
        <item name="android:windowSplashScreenBackground">@color/loader_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_brand_mark</item>
    </style>
</resources>
